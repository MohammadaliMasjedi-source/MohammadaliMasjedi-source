        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Postman smoke task\", \"priority\": \"high\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
