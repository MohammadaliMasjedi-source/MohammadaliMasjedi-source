            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Fixture restored\", () => pm.expect(pm.response.json().count).to.eql(3));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
